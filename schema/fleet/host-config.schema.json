{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagebrush.space/schema/fleet/host-config.schema.json",
  "title": "A grant agent's config, config_schema 1",
  "$comment": "Host supervisor freeze r3.1 (sha256 7f51ec735ca27968ebbb50dd3f21f765c9f203e04827fe3d50e8e3cb8fef1a12) §6.1. Closed: an unknown field refuses the grant. The rules one field imposes on another (allow only with allowlist, lan_allow only with full, mcp_allow a list under no-shell, path refusals, the memory bound against the host) are in lib/fleet/host/config.mjs, which also runs this schema.",
  "$ref": "#/$defs/config",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(/[^/\\u0000]+)+$",
      "minLength": 2,
      "maxLength": 1024,
      "$comment": "Absolute, no empty segment, no trailing slash; '.' and '..' segments are refused in code."
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(:[1-9][0-9]{0,4})?$",
      "maxLength": 259,
      "$comment": "An exact lowercase host name with at least one dot, optionally :port (1-65535, checked in code). No wildcard in v1."
    },
    "cidr": {
      "type": "string",
      "pattern": "^[0-9a-f.:]+/[0-9]{1,3}$",
      "maxLength": 43,
      "$comment": "Parsed and checked against the private ranges in code."
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$", "maxLength": 32 },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "name"],
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "prefixItems": [{ "$ref": "#/$defs/path" }],
          "items": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "wake": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["at_ms", "kind"], "properties": { "kind": { "const": "at" }, "at_ms": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["every_s", "kind"], "properties": { "kind": { "const": "every" }, "every_s": { "type": "integer", "minimum": 60, "maximum": 31536000 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "message" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "path", "poll_s"], "properties": { "kind": { "const": "path" }, "path": { "type": "string", "pattern": "^/", "minLength": 1, "maxLength": 1024 }, "poll_s": { "type": "integer", "minimum": 30, "maximum": 3600 } } }
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "gpu", "mcp_allow", "network", "programs", "resources", "turns", "wakes"],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ro", "rw"],
          "properties": {
            "rw": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
            "ro": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "lan_allow", "mode"],
          "properties": {
            "mode": { "enum": ["none", "allowlist", "full"] },
            "allow": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/host" } },
            "lan_allow": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/cidr" } }
          }
        },
        "programs": { "enum": ["run", "no-shell"] },
        "mcp_allow": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/mcp" } }
          ]
        },
        "gpu": { "type": "boolean" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_quota_pct", "cpu_weight", "disk_gb", "io_weight", "memory_max_mb", "nofile", "tasks_max"],
          "properties": {
            "memory_max_mb": { "type": "integer", "minimum": 256, "maximum": 16777216 },
            "tasks_max": { "type": "integer", "minimum": 64, "maximum": 65536 },
            "cpu_weight": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "cpu_quota_pct": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 1000000 }] },
            "io_weight": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "disk_gb": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "nofile": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
          }
        },
        "wakes": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/wake" } },
        "turns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["per_day", "wall_s"],
          "properties": {
            "per_day": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "wall_s": { "type": "integer", "minimum": 60, "maximum": 86400 }
          }
        }
      }
    }
  }
}
