# Files whose exact bytes are pinned (sha256 in a test or a pin) keep LF everywhere: Git for Windows' default
# core.autocrlf=true would check them out with CRLF, and their hashes would no longer match.
lib/*.json text eol=lf
# The browser lane's pinned protocol, spec and generated program (lib/fleet/browser/pins.mjs).
schema/fleet/browser/*.json text eol=lf
# The pinned zone data: compared byte for byte against lib/runner-pin.json, never converted.
lib/tzdata/** -text
# The fleet protocol's shared vectors and schemas: other implementations compare them byte for byte.
test/fixtures/*.json text eol=lf
schema/fleet/*.json text eol=lf
# IANA's registry files, byte-pinned (their sha256s are in schema/fleet/browser/special-addresses.json): never converted
schema/fleet/browser/iana/*.csv -text
# The turn's syscall policy fixtures: the pinned systemd's exact output (escapes included) and the derived numbers,
# compared byte for byte by scripts/seccomp-policy.mjs: never converted.
test/fixtures/seccomp/* -text
