{
  "name": "sagebrush-agent",
  "version": "0.5.0",
  "description": "Chat with Claude in Sagebrush: a small daemon on your computer that runs Claude (with your own Claude login) and talks to the Sagebrush page over the loopback address.",
  "type": "module",
  "bin": {
    "sagebrush-agent": "bin/sagebrush-agent.mjs"
  },
  "files": [
    "bin/",
    "lib/server.mjs",
    "lib/turns.mjs",
    "lib/notebook.mjs",
    "lib/canon.mjs",
    "lib/stdio.mjs",
    "lib/fake.mjs",
    "lib/page-tools.mjs",
    "lib/page-verbs.json",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "ws": "8.22.0",
    "zod": "4.6.7"
  }
}
