    "lib/fleet/",
    "schema/fleet/",
    "!schema/fleet/browser/cft-*.json",
    "lib/stdio.mjs",
    "lib/pair-stdin.mjs",
    "lib/stdout-thread.mjs",
    "lib/stdout-thread-worker.mjs",
    "lib/fake.mjs",
    "lib/codex.mjs",
    "lib/codex-turns.mjs",
    "lib/codex-fetch.mjs",
    "lib/win-acl.mjs",
    "lib/win-job.mjs",
