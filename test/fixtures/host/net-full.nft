add chain inet sagebrush in_7
add chain inet sagebrush fwd_7
add rule inet sagebrush input iifname "sbv7" jump in_7
add rule inet sagebrush agent_ingress iifname "sbv7" jump fwd_7
add rule inet sagebrush agent_return oifname "sbv7" ct state established,related accept
add rule inet sagebrush agent_return oifname "sbv7" drop
add rule inet sagebrush in_7 meta nfproto ipv6 drop
add rule inet sagebrush fwd_7 meta nfproto ipv6 drop
add rule inet sagebrush in_7 ip saddr != 10.250.0.30 drop
add rule inet sagebrush fwd_7 ip saddr != 10.250.0.30 drop
add rule inet sagebrush in_7 ip daddr 10.250.0.29 udp dport 53 accept
add rule inet sagebrush in_7 ip daddr 10.250.0.29 tcp dport 53 accept
add rule inet sagebrush in_7 drop
add rule inet sagebrush fwd_7 ip daddr 0.0.0.0/8 drop
add rule inet sagebrush fwd_7 ip daddr 127.0.0.0/8 drop
add rule inet sagebrush fwd_7 ip daddr 169.254.0.0/16 drop
add rule inet sagebrush fwd_7 ip daddr 100.64.0.0/10 drop
add rule inet sagebrush fwd_7 ip daddr 224.0.0.0/4 drop
add rule inet sagebrush fwd_7 ip daddr 240.0.0.0/4 drop
add rule inet sagebrush fwd_7 ip daddr 10.250.0.0/16 drop
add rule inet sagebrush fwd_7 ip daddr 10.128.0.5/32 drop
add rule inet sagebrush fwd_7 ip daddr 192.168.1.0/24 accept
add rule inet sagebrush fwd_7 ip daddr 10.0.0.0/8 drop
add rule inet sagebrush fwd_7 ip daddr 172.16.0.0/12 drop
add rule inet sagebrush fwd_7 ip daddr 192.168.0.0/16 drop
add rule inet sagebrush fwd_7 accept
add rule inet sagebrush postrouting ip saddr 10.250.0.30 oifname != "sbv7" masquerade
